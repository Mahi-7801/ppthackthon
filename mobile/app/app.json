{
  "expo": {
    "name": "SecureSign",
    "slug": "dsc-mobile-signing",
    "version": "1.0.0",
    "orientation": "portrait",
    "owner": "mahibujjipapas-team",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.securesign.app",
      "icon": "./assets/images/icon.png",
      "deploymentTarget": "16.0",
      "infoPlist": {
        "NFCReaderUsageDescription": "SecureSign uses NFC to communicate with DSC smart card tokens for digital signing.",
        "NSCameraUsageDescription": "SecureSign uses the camera to scan QR codes for document verification."
      },
      "entitlements": {
        "com.apple.security.smartcard": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "icon": "./assets/images/android-icon.png",
      "package": "com.securesign.app"
    },
    "extra": {
      "eas": {
        "projectId": "0ce87200-43b1-446c-af6c-9e87d801ba25"
      }
    },
    "plugins": [
      "expo-sharing",
      "./plugins/withDSCSigning"
    ],
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/0ce87200-43b1-446c-af6c-9e87d801ba25"
    }
  }
}
